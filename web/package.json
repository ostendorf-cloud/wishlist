{
  "name": "@ostendorf-cloud/wishlist-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && pnpm run prerender && pnpm run check:legal",
    "prerender": "vite build --ssr src/prerender.ts --outDir .prerender-ssr --emptyOutDir && govue-prerender --entry .prerender-ssr/prerender.js --template ../cmd/wishlist/dist/index.html --out-dir ../cmd/wishlist/dist && rm -rf .prerender-ssr",
    "check:legal": "govue-check-legal --dir ../cmd/wishlist/dist",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ostendorf-cloud/govue": "ostendorf-cloud/govue#v0.5.0&path:/web",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "vue-router": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.13"
  }
}
