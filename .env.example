# Copy to .env and adjust for docker compose. bin/wishlist reads the same
# variables from its environment.
#
# DB_PASSWORD is secret-shaped, so it has a _FILE twin: set DB_PASSWORD_FILE to
# a path instead, and the value is read from that file. Never both.

# Address the public HTTP server listens on.
# ADDR=:8080

# Address govue's admin listener listens on: /healthz, /readyz and /metrics.
# ADMIN_ADDR=:8081

# debug, info, warn or error.
# LOG_LEVEL=info

# PostgreSQL. DB_HOST, DB_NAME, DB_USER and the password are required.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=wishlist
# DB_USER=wishlist
# DB_PASSWORD=change-me-not-a-real-password
# DB_PASSWORD_FILE=/run/secrets/db-password
# disable, allow, prefer, require, verify-ca or verify-full.
# DB_SSLMODE=require
# Pool size per pod, 1 to 100.
# DB_MAX_CONNS=10
# One attempt to open a connection, 1s to 1m.
# DB_CONNECT_TIMEOUT=5s

# Own accounts. An owner registers with an email address, a password and a TOTP
# authenticator. Anybody can register while this is true; false (the default,
# in the binary and in the Helm chart as auth.registrationOpen) closes
# registration and the signup route answers 403. Accounts that never confirm
# their TOTP secret are deleted at the next signup after 24 hours.
# REGISTRATION_OPEN=true

# Proxies whose X-Forwarded-For is believed, comma separated addresses or CIDR
# ranges. Empty trusts nothing: the sign in limits then key by the connection
# address, which behind an ingress is the ingress for every caller. The Helm
# chart refuses to render an ingress or HTTPRoute without it.
# TRUSTED_PROXIES=10.42.0.0/16
# Behind an ingress no page view is counted without it, because the proxy is a
# private address.

# Public origin of the site. Its bare host is sent to Umami as the hostname.
# SITE_URL=https://my-wishes.de

# Page view counting through Umami, reported from the server. Off unless both
# are set; one alone stops the start. UMAMI_TIMEOUT (1s to 30s) and
# UMAMI_QUEUE_SIZE (1 to 10000) are optional.
# UMAMI_URL=https://umami.example.com
# UMAMI_WEBSITE_ID=00000000-0000-4000-8000-000000000000

# Development only: send the session cookie over plain http, without Secure and
# without the __Host- prefix. Refused unless ADDR is a loopback address
# (127.0.0.1:8080, [::1]:8080, localhost:8080). docker compose binds the
# container to every interface and publishes the port on 127.0.0.1 only, so it
# also sets the second variable to say so. Never set either one in a deployment.
# WISHLIST_ALLOW_PLAIN_HTTP=true
# WISHLIST_ALLOW_PLAIN_HTTP_ANY_LISTENER=true

# Tests only, not read by the binary: a PostgreSQL server whose role may create
# databases. Without it the store tests skip, loudly. CI sets it.
# WISHLIST_TEST_DATABASE_URL=postgres://wishlist:dev-password-not-real@127.0.0.1:5432/postgres?sslmode=disable

# Everything else (OIDC as a second way in, images, share tokens) is left out of
# this milestone; see AGENTS.md's "Scope of this milestone" section.
